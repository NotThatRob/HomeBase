# HomeBase advanced Docker Compose configuration
# For the recommended secure production path, use .env.prod.example with
# compose.prod.yaml. Use this file only if you are running the app+database
# Compose stack behind your own HTTPS reverse proxy.
#
# Copy to .env, set BASE_URL to your HTTPS domain, then replace every
# CHANGE_ME value before first boot.

# Compose
APP_PORT=8000

# PostgreSQL container
POSTGRES_DB=homebase
POSTGRES_USER=homebase
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# App
ENVIRONMENT=production
DEBUG=false
BASE_URL=https://homebase.example.com
UPLOAD_DIR=/data/uploads
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Server-side key used to encrypt users' authenticator secrets.
# Users set up two-factor authentication from Settings in the web UI.
TOTP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_RANDOM_32_BYTE_URLSAFE_BASE64_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SESSION_MAX_AGE=604800
COOKIE_SECURE=true
CSRF_ENABLED=true

# Email reminders
EMAIL_ENABLED=false
EMAIL_FROM=homebase@example.com
RESEND_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SQL=false
