# HomeBase Configuration
# Copy to .env and fill in values: cp .env.example .env

# Database
DATABASE_URL=postgresql://homebase:homebase@localhost:5432/homebase

# App
ENVIRONMENT=local
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=true
BASE_URL=http://localhost:8000
UPLOAD_DIR=./uploads
# In production, secure cookies and CSRF protection are required.
# COOKIE_SECURE and CSRF_ENABLED default to true when DEBUG=false.

# Admin user (created on first run if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Email reminders (disabled until configured)
EMAIL_ENABLED=false
EMAIL_FROM=homebase@example.com
RESEND_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=plain
LOG_SQL=false
