# HomeBase secure production configuration
# Copy this file to .env before deploying.
#
# Required edits:
# 1. Replace homebase.example.com with your real domain in HOMEBASE_DOMAIN,
#    BASE_URL, and ALLOWED_HOSTS.
# 2. Replace every CHANGE_ME value.
# 3. To limit a staging deployment to your IP, set HOMEBASE_ALLOWED_IPS.
#
# Then start HomeBase with:
# docker compose -f compose.prod.yaml up -d --build

# Public HTTPS hostname served by Caddy. Use the same domain in all three values.
HOMEBASE_DOMAIN=homebase.example.com
BASE_URL=https://homebase.example.com
ALLOWED_HOSTS=homebase.example.com

# Optional staging allowlist. For a private VPS test, use your IP with /32:
# HOMEBASE_ALLOWED_IPS=203.0.113.10/32
# Leave unset or use the default to allow all clients.
HOMEBASE_ALLOWED_IPS=0.0.0.0/0 ::/0

# PostgreSQL container
POSTGRES_DB=homebase
POSTGRES_USER=homebase
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# App safety settings
ENVIRONMENT=production
DEBUG=false
UPLOAD_DIR=/data/uploads
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SESSION_MAX_AGE=604800
COOKIE_SECURE=true
CSRF_ENABLED=true

# Email reminders
EMAIL_ENABLED=false
EMAIL_FROM=homebase@example.com
RESEND_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SQL=false
